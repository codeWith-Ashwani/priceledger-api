PRICELEDGER_DATABASE_URL=sqlite:///./priceledger.db
PRICELEDGER_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
PRICELEDGER_ADMIN_TOKEN=
PRICELEDGER_DEMO_MODE=false
PRICELEDGER_DISCOVERY_RETAILERS=["amazon","flipkart","meesho","croma","reliance","iqoo","sony","boat"]

PRICELEDGER_LOOKUP_CACHE_MINUTES=15
# -1 checks all registered sources; 0 disables extra discovery.
PRICELEDGER_DISCOVERY_EXTRA_STORE_LIMIT=-1
PRICELEDGER_LOOKUP_REQUESTS_PER_MINUTE=12
PRICELEDGER_READ_REQUESTS_PER_MINUTE=120
PRICELEDGER_ADMIN_REQUESTS_PER_MINUTE=60
PRICELEDGER_REQUEST_BODY_BYTES=1500000
PRICELEDGER_REQUEST_BODY_TIMEOUT_SECONDS=15
PRICELEDGER_COMPARISON_LEASE_SECONDS=600
PRICELEDGER_MAX_HISTORY_OBSERVATIONS=10000
PRICELEDGER_DATABASE_POOL_SIZE=5
PRICELEDGER_DATABASE_MAX_OVERFLOW=5
PRICELEDGER_DATABASE_POOL_TIMEOUT_SECONDS=10
PRICELEDGER_DATABASE_STATEMENT_TIMEOUT_MS=30000
PRICELEDGER_DATABASE_LOCK_TIMEOUT_MS=5000
PRICELEDGER_COLLECTION_DAILY_BUDGET=500
PRICELEDGER_COLLECTION_ACTIVE_HOURS=6
PRICELEDGER_COLLECTION_STABLE_HOURS=24
PRICELEDGER_COLLECTION_LEASE_MINUTES=5
PRICELEDGER_COLLECTION_COOLDOWN_HOURS=6
